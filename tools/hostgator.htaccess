# Brandaz na HostGator (Apache, subdomínio novo.brandaz.com.br): tipos do streaming, cache, compressão e sem listagem de pastas
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /index.html

AddType application/vnd.apple.mpegurl .m3u8
AddType video/mp2t .ts
AddType font/woff2 .woff2
AddType image/webp .webp

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/vnd.apple.mpegurl
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(webp|jpg|png|woff2|mp4|ts)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js|m3u8)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>
</IfModule>
